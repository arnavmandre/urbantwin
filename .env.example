# Copy this file to .env and replace the placeholders. Never commit .env.

# AI advisor + advisor chat: an Agent 37 hosted Hermes agent (agent37.com).
# Key: https://www.agent37.com/dashboard/cloud/api-keys   URL: https://<agent-id>.agent37.app
AGENT37_API_KEY=replace_with_your_sk_live_key
AGENT37_AGENT_URL=https://your-agent-id.agent37.app

# Optional fallback for the ranking advisor only, used when Agent 37 is not configured.
GROQ_API_KEY=replace_with_your_new_groq_key
