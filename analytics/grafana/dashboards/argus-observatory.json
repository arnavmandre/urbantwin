{
  "uid": "argus-observatory",
  "title": "Argus Urban Risk Observatory",
  "description": "Run history and baseline-vs-intervention comparisons for Argus simulator runs.",
  "tags": [
    "argus"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "time": {
    "from": "now-60d",
    "to": "now"
  },
  "links": [
    {
      "title": "Open Argus",
      "type": "link",
      "url": "http://localhost:3000/",
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "argus-pg"
        },
        "query": "SELECT run_id FROM analytics.simulation_runs WHERE status = 'complete' ORDER BY created_at DESC",
        "definition": "completed runs, newest first",
        "refresh": 2,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      },
      {
        "name": "metric",
        "label": "Trend metric",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "argus-pg"
        },
        "query": "SELECT metric_name AS __value, metric_label AS __text FROM (SELECT DISTINCT metric_name, metric_label FROM analytics.simulation_metrics) m ORDER BY metric_name = 'human_experience_index' DESC, metric_label",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      },
      {
        "name": "metric_label",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "argus-pg"
        },
        "query": "SELECT DISTINCT metric_label FROM analytics.simulation_metrics WHERE metric_name = '$metric'",
        "refresh": 1,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "id": 2,
      "transparent": true,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**What this shows.** Every number below is copied from Argus simulator output (`data/runs/`) or the API's run log. Scores are heuristic prototype estimates from synthetic, survey-calibrated citizens, not validated predictions. Temperature, humidity and rainfall are **scenario inputs someone typed**, not observed weather. Baseline and intervention are the before and after arms of the **same run**."
      }
    },
    {
      "type": "row",
      "title": "Run summary (all imported runs)",
      "id": 3,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Simulation runs",
      "id": 4,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "argus-pg"
      },
      "description": "Every run imported: completed runs from data/runs/, plus failed or cancelled runs the API logged.",
      "gridPos": {
        "h": 4,
        "w": 5,
