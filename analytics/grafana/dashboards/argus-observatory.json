        "type": "grafana-postgresql-datasource",
        "uid": "argus-pg"
      },
      "description": "Only runs the API logged to data/run_events.jsonl. Failures before that log existed, and CLI failures, are not counted.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
