      "title": "Completed",
      "id": 5,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "argus-pg"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 4
      },
      "targets": [
