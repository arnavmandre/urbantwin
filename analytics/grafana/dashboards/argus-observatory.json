            "type": "grafana-postgresql-datasource",
            "uid": "argus-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE status <> 'complete') AS failed FROM analytics.simulation_runs"
