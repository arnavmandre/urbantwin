            "type": "grafana-postgresql-datasource",
            "uid": "argus-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'complete') AS completed FROM analytics.simulation_runs"
