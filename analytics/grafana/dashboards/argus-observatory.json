          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2563eb"
          },
          "noValue": "No runs imported",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Latest completed run",
      "id": 8,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "argus-pg"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "argus-pg"
          },
          "editorMode": "code",
