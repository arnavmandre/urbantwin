          "rawSql": "SELECT run_label AS \"Run\", temperature_c AS \"Temperature °C\", humidity_pct AS \"Humidity %\",\n       rainfall_prototype AS \"Rainfall (prototype scale)\"\nFROM (SELECT r.run_id || '  ' || coalesce(r.scenario_preset, 'custom') AS run_label, r.created_at, i.*\n      FROM analytics.simulation_runs r JOIN analytics.scenario_inputs i USING (run_id)\n      WHERE $__timeFilter(r.created_at)\n      ORDER BY r.created_at DESC LIMIT 15) t\nORDER BY created_at DESC"
