        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Average pipeline time",
      "id": 7,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "argus-pg"
      },
      "description": "Sum of the pipeline's recorded stage times for completed runs (simulation, export, USD, validation). Excludes queueing.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 15,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "argus-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT avg(pipeline_seconds) AS seconds FROM analytics.simulation_runs WHERE status = 'complete'"
