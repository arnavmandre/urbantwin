[package]
title = "UrbanTwin AI Streaming"
version = "0.1.0"
description = "Streaming layer for the UrbanTwin AI Kit application (local WebRTC)."
keywords = ["experience", "app", "dev", "streaming"]
template_name = "omni.streaming_configuration"

[dependencies]
"urbantwin" = {}  # Desktop base editor application
"omni.kit.livestream.app" = {}  # Kit App Streaming / WebRTC
"omni.kit.livestream.messaging" = {}  # Inbound WebRTC data-channel messages -> carb events.
# Stage open + view commands: enabled at launch via --ext-folder + --enable
# urbantwin.stage_autoload / urbantwin.view_commands (unbuilt source exts stay
# off the dependency lock).

[settings.app]
fastShutdown = true
name = "UrbanTwin AI Streaming"
# 720p30 instead of 1080p60. Pixel throughput drops to ~22% of the original
# (0.44x the pixels, 0.5x the frames), which is the single biggest win on a
# laptop GPU that was pinned at 100% and 78 C.
renderer.resolution.height = 720
renderer.resolution.width = 1280
window.height = 720
window.width = 1280
# Stage path is supplied at launch via --/app/auto_load_usd so this file stays
# machine-portable. Example:
#   --/app/auto_load_usd=C:/Users/arnav/Argus/phase9/scene/main.usda

[settings]
rtx.post.aa.op = 3
rtx.verifyDriverVersion.enabled = false
app.livestream.allowResize = 1
app.livestream.skipCapture = 1

# omni.kit.livestream.app defaults every run loop to 60 Hz and Kit re-renders
# continuously even when the scene is idle. Halving these caps the whole
# render/encode pipeline at 30 fps, which is plenty for a streamed viewport.
app.runLoops.main.rateLimitEnabled = true
app.runLoops.main.rateLimitFrequency = 30
app.runLoops.present.rateLimitEnabled = true
app.runLoops.present.rateLimitFrequency = 30
app.runLoops.rendering_0.rateLimitEnabled = true
app.runLoops.rendering_0.rateLimitFrequency = 30
app.runLoops.rendering_1.rateLimitEnabled = true
app.runLoops.rendering_1.rateLimitFrequency = 30

# Idle scenes should not burn frames. Kit still streams; it just stops
# re-rendering identical pixels as aggressively.
app.renderer.skipWhileMinimized = true
app.renderer.sleepMsOnFocus = 0
app.renderer.sleepMsOutOfFocus = 10

# DLSS Frame Generation multiplies whatever the viewport ticks at, which pushed
# the HUD to 240 fps (120 Hz tick x2) past every cap. NVIDIA's own streaming
# viewer template disables it for exactly this reason.
rtx-transient.dlssg.enabled = false

# Clean stream: the viewport should fill the frame with no editor furniture.
# (Per-window values saved in the user config override these defaults; the
# urbantwin.stage_autoload extension re-forces them at runtime.)
app.viewport.forceHideFps = true
app.viewport.defaults.fillViewport = true
app.viewport.defaults.hud.visible = false
app.viewport.defaults.hud.renderFPS.visible = false
app.viewport.defaults.hud.renderResolution.visible = false
app.viewport.defaults.hud.renderProgress.visible = false
app.viewport.defaults.hud.deviceMemory.visible = false
app.viewport.defaults.hud.hostMemory.visible = false
app.viewport.defaults.hud.cameraSpeed.visible = false
app.viewport.defaults.hud.toastMessage.visible = false
app.viewport.defaults.guide.grid.visible = false
app.viewport.defaults.guide.axis.visible = false
app.viewport.defaults.scene.cameras.visible = false
app.viewport.defaults.scene.lights.visible = false

[settings.persistent]
app.viewport.noPadding = true
metricsAssembler.showUnitsOverlay = false

[settings.app.extensions]
registryEnabled = true
supportedTargets.platform = []

exclude = [
    "omni.kit.developer.bundle",
    "omni.kit.widget.cache_indicator",
]

[settings.app.exts]
folders.'++' = [
    "${app}/../exts",
    "${app}/../apps",
    "${app}/../extscache"
]

[settings.app.file]
ignoreUnsavedOnExit = true


